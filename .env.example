# LightRAG Configuration — Equal Experts Case Studies
# Copy to .env and adjust as needed
#
# Hard constraint: fully local only.
# Uses llama.cpp (llama-server) with OpenAI-compatible REST API.
# One server instance per model — LLM on :8080, embeddings on :8081.

# === LLM (llama-server on port 8080) ===
# Model: LFM2.5-1.2B-Thinking (Q4_K_M)
LLM_BINDING=openai
LLM_BINDING_HOST=http://localhost:8080/v1
LLM_MODEL=lfm2.5-1.2b-thinking
# Dummy key — llama-server ignores it, but LightRAG's OpenAI client
# crashes if this is unset or empty.
LLM_BINDING_API_KEY=sk-no-key-needed

# === Embeddings (llama-server on port 8081) ===
# Model: bge-m3 (Q8_0, 1024-dim)
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://localhost:8081/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_BINDING_API_KEY=sk-no-key-needed
EMBEDDING_DIM=1024

# === Reranker ===
# No local reranker available in LightRAG's current bindings.
# Cloud-only options (cohere, jina, aliyun) are not used.
RERANK_BINDING=null

# === Storage ===
# Default: in-memory with local file persistence
# For production, use PostgreSQL:
# KV_STORAGE=PostgresKV
# VECTOR_STORAGE=PostgresVectorStorage
# GRAPH_STORAGE=Neo4JStorage
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=lightrag
# POSTGRES_PASSWORD=lightrag
# POSTGRES_DATABASE=lightrag
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=lightrag

# === LightRAG Server ===
LIGHTRAG_API_KEY=
# Host: 127.0.0.1 for local-only, 0.0.0.0 for network access
HOST=127.0.0.1
PORT=9621

# === Chunking ===
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
# Strategy: fixed, recursive, vector, paragraph
CHUNK_METHOD=paragraph

# === Ingest Tuning ===
MAX_PARALLEL_INSERT=4
ENABLE_LLM_CACHE_FOR_EXTRACT=true