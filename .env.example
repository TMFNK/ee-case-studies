# LightRAG Configuration — Equal Experts Case Studies
# Copy to .env and adjust as needed
#
# Hard constraint: fully local only.
# Uses llama.cpp (llama-server) with OpenAI-compatible REST API.
# LLM :8080, embeddings :8081, extract :8082. Start with: scripts/start_servers.sh
#
# Use 127.0.0.1 (not localhost) — servers bind IPv4 only; localhost may hit ::1 first.

# === LLM (generation / query — llama-server on :8080) ===
# LightRAG has no native llama.cpp binding, so we point the `openai` binding
# at llama-server. Must match the --alias passed to llama-server.
LLM_BINDING=openai
LLM_BINDING_HOST=http://127.0.0.1:8080/v1
LLM_MODEL=lfm2.5-1.2b-thinking
# DUMMY key: required, otherwise LightRAG falls back to OPENAI_API_KEY and
# raises KeyError. llama-server ignores the key unless started with --key.
LLM_BINDING_API_KEY=sk-no-key-needed

# === Extract LLM (entity/relation extraction — llama-server on :8082) ===
# LFM2.5-1.2B-Thinking returns prose instead of extraction JSON, so a
# dedicated extract model is required for a non-empty knowledge graph.
EXTRACT_LLM_BINDING=openai
EXTRACT_LLM_BINDING_HOST=http://127.0.0.1:8082/v1
EXTRACT_LLM_MODEL=lfm2-350m-extract
EXTRACT_LLM_BINDING_API_KEY=sk-no-key-needed

# === Embeddings (llama-server on :8081) ===
# bge-m3 served with --embedding --pooling mean
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://127.0.0.1:8081/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_BINDING_API_KEY=sk-no-key-needed
EMBEDDING_DIM=1024
# Must match llama-server --ctx-size / -ub for bge-m3 (see start_servers.sh).
EMBEDDING_TOKEN_LIMIT=2048

# === Reranker (no local option — disabled) ===
# LightRAG only wires cloud rerankers (cohere, jina, aliyun).
RERANK_BINDING=null

# === Ingest tuning ===
# Keep parallel inserts low on 8GB machines (local models share Metal + RAM).
# Prefer: scripts/start_servers.sh start ingest   (extract+embed only)
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
MAX_PARALLEL_INSERT=1
EXTRACT_MAX_ASYNC_LLM=1
MAX_ASYNC_LLM=1
ENABLE_LLM_CACHE_FOR_EXTRACT=true
# LFM2-Extract returns JSON; delimiter mode leaves the graph empty (0 Ent/Rel).
ENTITY_EXTRACTION_USE_JSON=true
# Second extract pass (gleaning) doubles prompt size and overflows 16k ctx.
MAX_GLEANING=0

# === Storage ===
# Default: in-memory with local file persistence (./rag_storage)
# For production, use PostgreSQL:
# KV_STORAGE=PostgresKV
# VECTOR_STORAGE=PostgresVectorStorage
# GRAPH_STORAGE=Neo4JStorage
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=lightrag
# POSTGRES_PASSWORD=lightrag
# POSTGRES_DATABASE=lightrag
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=lightrag

# === LightRAG Server ===
LIGHTRAG_API_KEY=
# Host: 127.0.0.1 for local-only, 0.0.0.0 for network access
HOST=127.0.0.1
PORT=9621
