# LightRAG Configuration — Equal Experts Case Studies
# Copy to .env and adjust as needed

# === LLM (Ollama) ===
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_MODEL=llama3.2
# Role-specific models (optional — defaults to LLM_MODEL)
# EXTRACT_MODEL=llama3.2
# QUERY_MODEL=llama3.2
# KEYWORD_MODEL=llama3.2

# === Embeddings (Ollama) ===
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# === Reranker (optional, improves mixed-query quality) ===
# RERANK_BINDING=ollama
# RERANK_MODEL=bge-reranker-v2-m3

# === Storage ===
# Default: in-memory with local file persistence
# For production, use PostgreSQL:
# KV_STORAGE=PostgresKV
# VECTOR_STORAGE=PostgresVectorStorage
# GRAPH_STORAGE=Neo4JStorage
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=lightrag
# POSTGRES_PASSWORD=lightrag
# POSTGRES_DATABASE=lightrag
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=lightrag

# === LightRAG Server ===
LIGHTRAG_API_KEY=
# Host: 127.0.0.1 for local-only, 0.0.0.0 for network access
HOST=127.0.0.1
PORT=9621

# === Chunking ===
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
# Strategy: fixed, recursive, vector, paragraph
CHUNK_METHOD=paragraph