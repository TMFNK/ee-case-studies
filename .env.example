# === LLM (OpenAI-compatible llama.cpp server on :8080) ===
# LightRAG has no native llama.cpp binding, so we point the `openai` binding
# at llama-server. Start both servers first: scripts/start_servers.sh
LLM_BINDING=openai
LLM_BINDING_HOST=http://localhost:8080/v1
# Must match the --alias passed to llama-server (LFM2.5-1.2B-Thinking)
LLM_MODEL=lfm2.5-1.2b-thinking
# DUMMY key: required, otherwise LightRAG falls back to OPENAI_API_KEY and
# raises KeyError. llama-server ignores the key unless started with --key.
LLM_BINDING_API_KEY=sk-no-key-needed
# Role-specific models (optional — defaults to LLM_MODEL)
# EXTRACT_MODEL=lfm2.5-1.2b-thinking
# QUERY_MODEL=lfm2.5-1.2b-thinking
# KEYWORD_MODEL=lfm2.5-1.2b-thinking

# === Embeddings (OpenAI-compatible llama.cpp server on :8081) ===
# bge-m3 served by llama-server with --embedding --pooling mean
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://localhost:8081/v1
# Must match the --alias passed to the embedding llama-server
EMBEDDING_MODEL=bge-m3
EMBEDDING_BINDING_API_KEY=sk-no-key-needed
# bge-m3 output dimension
EMBEDDING_DIM=1024

# === Reranker (no local option — disabled) ===
# LightRAG only wires cloud rerankers (cohere, jina, aliyun), so disable it.
RERANK_BINDING=null

# === Ingest tuning (keep extraction fast and cacheable) ===
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
MAX_PARALLEL_INSERT=4
ENABLE_LLM_CACHE_FOR_EXTRACT=true
